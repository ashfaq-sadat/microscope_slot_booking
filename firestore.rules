rules_version = '2';

// BX53 booking — Firestore security rules (member accounts version)
// Paste into Firebase console → Firestore Database → Rules → Publish.
// Keep the numbers in sync with config.js (minutes after midnight).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // >>> Admin email(s): same as config.js adminEmails <<<
    function isAdmin() {
      return signedIn() && request.auth.token.email in ['sadat43747@bau.edu.bd'];
    }

    // The signed-in person's member record (created by the admin)
    function me() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && me().active == true;
    }

    function validTimes(d) {
      return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.start is int && d.end is int
        && d.start % 15 == 0 && d.end % 15 == 0
        && d.start >= 480 && d.end <= 1200 && d.start < d.end;
    }

    // 1 = Mon … 5 = Fri, 6 = Sat, 7 = Sun
    function dow(d) {
      return timestamp.date(int(d.date[0:4]), int(d.date[5:7]), int(d.date[8:10])).dayOfWeek();
    }
    function isOffDay(d) { return dow(d) in [5, 6]; }   // Friday & Saturday

    function inWindow(d) {
      return timestamp.date(int(d.date[0:4]), int(d.date[5:7]), int(d.date[8:10]))
             < request.time + duration.value(7, 'd');
    }

    // Workdays: female 08:00–14:00, male 08:00–20:00. Off days: male only. Max 4 h.
    // Name, username and group must match the member record, so nobody can book as someone else.
    function validMemberBooking(d) {
      let m = me();
      return d.type == 'booking'
        && d.username == m.username && d.name == m.name && d.gender == m.gender
        && d.end - d.start <= 240
        && inWindow(d)
        && ((m.gender == 'female' && d.end <= 840 && !isOffDay(d))
         || (m.gender == 'male'));
    }

    match /bookings/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && validTimes(request.resource.data)
        && request.resource.data.purpose is string
        && request.resource.data.purpose.size() > 0 && request.resource.data.purpose.size() <= 200
        && (isAdmin() || (isMember() && validMemberBooking(request.resource.data)));
      allow delete: if isAdmin()
        || (isMember() && resource.data.username == me().username);
      allow update: if false;
    }

    // One lock per 15-min step. "create" fails if the lock already exists,
    // which is what stops double-booking. No extra lookups here on purpose
    // (a booking writes up to 16 locks in one batch).
    match /locks/{lockId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.m is int
        && request.resource.data.m % 15 == 0
        && request.resource.data.m >= 480 && request.resource.data.m < 1200
        && lockId == request.resource.data.date + '_' + string(request.resource.data.m);
      // Owner, admin, or anyone deleting the booking the lock belongs to (in the same batch)
      allow delete: if signedIn() && (
           resource == null
        || resource.data.uid == request.auth.uid
        || isAdmin()
        || !existsAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)));
      allow update: if false;
    }

    // Member records: admin only writes; signed-in users can read (to load their own profile)
    match /members/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // username → hidden login email. Public read so the login box can look it up.
    match /usernames/{username} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
